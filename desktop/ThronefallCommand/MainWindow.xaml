<Window x:Class="ThronefallCommand.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Thronefall Command" Background="#120c08"
        MinWidth="640" MinHeight="420">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- Command bar: port, connect, zoom, window modes, settings -->
    <Grid Grid.Row="0" Margin="6,5">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <TextBlock Grid.Column="0" VerticalAlignment="Center" Foreground="#f0b35e"
                 FontWeight="Bold" Margin="0,0,6,0">👑</TextBlock>
      <ComboBox x:Name="PortBox" Grid.Column="1" Width="96" IsEditable="True"
                ToolTip="Port — free ports listed; type any port"/>
      <Button x:Name="BtnConnect" Grid.Column="2" Click="Connect_Click"
              ToolTip="Attach/launch the coach server on this port">Connect</Button>
      <Button x:Name="BtnRefreshPorts" Grid.Column="3" Click="RefreshPorts_Click"
              ToolTip="Re-scan free ports">⟳</Button>
      <TextBlock Grid.Column="4" VerticalAlignment="Center" Foreground="#a89878"
                 Margin="8,0,2,0">zoom</TextBlock>
      <Slider x:Name="ZoomSlider" Grid.Column="5" Width="110" Minimum="0.5" Maximum="2.5"
              Value="1.0" TickFrequency="0.1" VerticalAlignment="Center"
              ValueChanged="Zoom_Changed" ToolTip="UI scale (fonts, panels, buttons)"/>
      <CheckBox x:Name="TopMostBox" Grid.Column="6" Foreground="#a89878"
                VerticalAlignment="Center" Margin="6,0" ToolTip="Always on top"
                Content="pin" Checked="Top_Changed" Unchecked="Top_Changed"/>
      <Border Grid.Column="7" Width="1" Margin="6,2" Background="#4a3826"/>
      <Button x:Name="BtnFull" Grid.Column="8" Click="Full_Click" ToolTip="Fullscreen / windowed">⛶</Button>
      <Button x:Name="BtnCompact" Grid.Column="9" Click="Compact_Click"
              ToolTip="Compact (~40% screen) / restore">◱</Button>
      <Button x:Name="BtnLock" Grid.Column="10" Click="Lock_Click" ToolTip="Lock window size">🔒</Button>
      <Button x:Name="BtnGear" Grid.Column="11" Click="Gear_Click" ToolTip="Settings &amp; profiles">⚙</Button>
    </Grid>

    <wv2:WebView2 x:Name="Web" Grid.Row="1" Margin="6,0,6,0"/>

    <Grid Grid.Row="2" Margin="6,2">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <TextBlock x:Name="Status" Foreground="#a89878" FontSize="11" VerticalAlignment="Center"/>
      <TextBlock x:Name="ProfileLabel" Grid.Column="1" Foreground="#f0b35e" FontSize="11"
                 VerticalAlignment="Center"/>
    </Grid>

    <!-- Settings flyout: profiles + trainer path + save -->
    <Border x:Name="SettingsFlyout" Grid.Row="1" HorizontalAlignment="Right"
            VerticalAlignment="Top" Width="300" Margin="0,0,10,0" Padding="12"
            Background="#1c1410" BorderBrush="#f0b35e" BorderThickness="1"
            CornerRadius="8" Visibility="Collapsed">
      <StackPanel>
        <TextBlock Foreground="#f0b35e" FontWeight="Bold" Margin="0,0,0,8">Settings &amp; Profiles</TextBlock>
        <TextBlock Foreground="#a89878" FontSize="11">trainer root (tools\coach-server.py)</TextBlock>
        <TextBox x:Name="RootBox" Background="#150e0a" Foreground="#e8dcc4" Margin="0,2,0,8"/>
        <TextBlock Foreground="#a89878" FontSize="11">profile</TextBlock>
        <ComboBox x:Name="ProfileBox" IsEditable="True"/>
        <DockPanel Margin="0,6,0,0">
          <Button Content="Save" DockPanel.Dock="Right" Click="SaveProfile_Click" Width="70"/>
          <Button Content="Load" DockPanel.Dock="Right" Click="LoadProfile_Click" Width="70"/>
        </DockPanel>
        <Button Content="Apply &amp; reconnect" Click="Apply_Click" Margin="0,10,0,0"/>
        <TextBlock Foreground="#a89878" FontSize="10" TextWrapping="Wrap" Margin="0,8,0,0"
                   Text="Profiles save port, zoom, window size, on-top and lock state. MiniMax drives the same controls over HTTP — /mmapi lists every endpoint."/>
      </StackPanel>
    </Border>
  </Grid>
</Window>
